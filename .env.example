# Скопіюйте цей файл у .env і заповніть значення (без лапок і пробілів після =).

# Ключ з https://steamcommunity.com/dev/apikey (поле «Domain Name» — будь-що, напр. localhost)
STEAM_API_KEY=

# Ваш SteamID64 (17 цифр, напр. 7656119xxxxxxxxxx) — видно на https://steamid.io або в URL профілю
STEAM_ID=

# Токен для сімейної бібліотеки. Діє ~24 год. Як отримати — див. README.md
STEAM_ACCESS_TOKEN=
